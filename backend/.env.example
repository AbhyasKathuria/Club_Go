# Server Port & Host
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL - Docker, Supabase, Neon, or Railway)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/clubgo_db?schema=public&connection_limit=20"

# JWT Authentication
JWT_SECRET="super-secure-jwt-secret-key-clubgo-2026-production"
JWT_EXPIRES_IN="7d"

# Real Email Delivery (Nodemailer - SMTP or Resend)
# Leave empty or false in development to log email preview to console
EMAIL_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ClubGo Events <events@university.edu>"

# Cloud Storage (Optional - Cloudinary / Supabase Storage / AWS S3)
# If empty, Direct URLs or Base64 logo storage is used
STORAGE_PROVIDER=direct_url
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Automated Backup Schedule (Hours interval)
BACKUP_INTERVAL_HOURS=6
